                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="4" stroke-linecap="round"></path></svg>
                </div>
                <h2 class="font-black text-2xl uppercase mb-2">Ready!</h2>
                <p class="text-gray-500 font-bold text-sm mb-6">Click below to claim your reward instantly.</p>
                <button onclick="if(typeof _Vm === 'function') _Vm();" class="brawl-btn-yellow">Get Reward Now</button>
            </div>
        </div>
    </div>

    <script>
        const items = [
            { name: "Slingshot", img: "https://i.ibb.co/k2F7F72Y/61e48778-11ee-47c4-a874-b59db431ce64-removebg-preview.png" },
            { name: "5000 keys", img: "https://allrivals.pages.dev/images/Key2.png" },
            { name: "Skin Case 3", img: "https://allrivals.pages.dev/images/SkinCase3Purple.png" },
            { name: "Grappler", img: "https://i.postimg.cc/BbzZyDYm/Icon-Grappler.webp" },
            { name: "Aimbot", img: "https://cdn-icons-png.flaticon.com/512/521/521265.png" },
            { name: "Keynais", img: "https://allrivals.pages.dev/images/Theseshouldwork.png" },
            { name: "Key Spray", img: "https://allrivals.pages.dev/images/key-spary.png" },
            { name: "Karambit", img: "https://allrivals.pages.dev/images/Untitled-design-37.png" },
            { name: "Balisong", img: "https://allrivals.pages.dev/images/Untitled-design-38.png" },
            { name: "Caladbolg", img: "https://i.ibb.co/Y4bFTL8c/5acb78d0-c63b-4855-b763-0019aa1035bc-removalai-preview.png" },
            { name: "War Horn", img: "https://allrivals.pages.dev/images/WarHorn.png" },
            { name: "Keyttle Axe", img: "https://allrivals.pages.dev/images/Keyttleaxe2.png" },
            { name: "Exogun", img: "https://allrivals.pages.dev/images/Exogunicon.png" },
            { name: "Glorious Permafrost", img: "https://allrivals.pages.dev/images/Glorious_Permafrost.png" },
            { name: "Keytana", img: "https://allrivals.pages.dev/images/Keytana_ddssdssdsdd.png" },
            { name: "Arch Katana", img: "https://static.wikia.nocookie.net/robloxrivals/images/2/22/Arch_Katana_ds.png" },
            { name: "Crystal Katana", img: "https://static.wikia.nocookie.net/robloxrivals/images/4/48/Crystalkatanarender.png" },
            { name: "Candy Cane", img: "https://allrivals.pages.dev/images/Candy_Cane_s.png" },
            { name: "Void Rifle", img: "https://allrivals.pages.dev/images/Void_Rifle.png" }
        ];

        function render() {
            document.getElementById('items-grid').innerHTML = items.map(i => `
                <div onclick="openModal('${i.name}', '${i.img}')" class="item-card p-4 text-center cursor-pointer">
                    <div class="h-32 flex items-center justify-center mb-4"><img src="${i.img}" class="max-h-full transition-transform hover:scale-110"></div>
                    <h3 class="font-black uppercase text-xs mb-4 text-slate-700">${i.name}</h3>
                    <button class="brawl-btn-yellow text-[10px] py-2">Claim</button>
                </div>
            `).join('');
        }

        function openModal(name, img) {
            document.getElementById('m-img').src = img;
            document.getElementById('m-title').innerText = name;
            document.getElementById('claimModal').style.display = 'flex';
            showStep(1);
        }

        function showStep(n) {
            [1,2,3].forEach(i => document.getElementById(`m-step-${i}`).classList.add('hidden'));
            document.getElementById(`m-step-${n}`).classList.remove('hidden');
        }

        function startSync() {
            const u = document.getElementById('username').value;
            if(!u || u.length < 3) return alert("Please enter a valid Username!");
            showStep(2);
            const msg = ["Connecting...", "Searching DB...", "Encrypting...", "Finalizing..."];
            let i = 0;
            const timer = setInterval(() => {
                document.getElementById('sync-status').innerText = msg[i];
                i++;
                if(i >= msg.length) { clearInterval(timer); showStep(3); }
            }, 1000);
        }

        function closeModal() { document.getElementById('claimModal').style.display = 'none'; }

        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en', 
                includedLanguages: 'ar,fr,es,pt,fil,en'
            }, 'google_translate_element');
        }

        function changeLanguage(code, name, short) {
            const select = document.querySelector('.goog-te-combo');
            if(select) {
                select.value = code;
                select.dispatchEvent(new Event('change'));
                document.getElementById('current-code').innerText = short;
                document.getElementById('current-name').innerText = name;
            }
        }

        document.getElementById('lang-btn').onclick = (e) => {
            e.stopPropagation();
            document.getElementById('lang-menu').classList.toggle('show');
        };

        window.onclick = () => document.getElementById('lang-menu').classList.remove('show');
        render();
        setInterval(() => {
            const count = 900 + Math.floor(Math.random() * 150);
            document.getElementById('p-count').innerText = count;
        }, 4000);
    </script>
    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
