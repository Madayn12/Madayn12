        .brawl-btn-yellow:active { transform: translateY(3px); border-bottom-width: 2px; }
        .item-card { background: white; border-radius: 1.5rem; border: 3px solid white; transition: 0.3s; box-shadow: 0 8px 20px rgba(0,0,0,0.05); }
